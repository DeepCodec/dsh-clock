{
  "name": "@deepcodec/dsh-clock",
  "description": "DSH Web clock: shows the current date & time in the bottom status bar (composer dock), with user-configurable format.",
  "version": "1.0.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.spec.mjs",
    "prepublishOnly": "node build.mjs && node --test test/*.spec.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-client-store": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "esbuild": "^0.25.0",
    "immer": "^11.1.21",
    "react": "^18.3.1",
    "react-test-renderer": "^18.3.1",
    "zustand": "^4.4.7"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": ">=0.2.0-rc.1 <1.0.0-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.0-rc.1 <1.0.0-0",
    "@deepseek-ai/schemastery": "^3.18.2",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.1-rc.1": "unknown",
        "0.1.5-rc.2": "compatible",
        "0.1.7-rc.2": "compatible",
        "0.2.0-rc.1": "compatible",
        "0.2.0-rc.2": "compatible"
      }
    }
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "author": "Longshan Du <longshan.du@gmail.com>",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "clock",
    "date",
    "time",
    "status-bar",
    "cordis",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeepCodec/dsh-clock.git"
  },
  "homepage": "https://github.com/DeepCodec/dsh-clock",
  "bugs": {
    "url": "https://github.com/DeepCodec/dsh-clock/issues"
  }
}
